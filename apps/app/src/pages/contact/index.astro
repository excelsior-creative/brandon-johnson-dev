---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { site } from "@/data/site";
---

<BaseLayout
  title="Contact J. Brandon Johnson"
  description="Get in touch with Brandon Johnson about AI agent development, full stack engineering, automation consulting, or collaboration opportunities."
  canonical="/contact"
>
  <section class="section page-top">
    <div class="container">
      <SectionHeading
        eyebrow="Let's connect"
        title="Get in touch"
        description="Have a question or want to build something together? Drop a note and I'll get back to you."
      />
      <div class="contact-grid">
        <aside class="contact-list">
          <a class="glass-card" href={`mailto:${site.email}`}><span>Email</span><strong>{site.email}</strong></a>
          <div class="glass-card"><span>Location</span><strong>Orange County, CA</strong></div>
          <div class="socials">{site.socials.map((link) => <a href={link.href}>{link.label}</a>)}</div>
        </aside>
        <form class="contact-form" method="post" action="/api/contact" data-contact-form>
          <label>Name<input name="name" autocomplete="name" maxlength="100" required /></label>
          <label>Email<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
          <label>Message<textarea name="message" rows="7" maxlength="5000" required></textarea></label>
          <label class="contact-honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
          <button class="button primary" type="submit" data-submit-button>Send message</button>
          <p class="form-status" data-form-status aria-live="polite"></p>
          <noscript>
            <p class="form-status">JavaScript is disabled. Email Brandon directly at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
          </noscript>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector("[data-contact-form]");
    const status = document.querySelector("[data-form-status]");
    const submitButton = document.querySelector("[data-submit-button]");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || !(submitButton instanceof HTMLButtonElement)) return;

      const data = Object.fromEntries(new FormData(form));
      submitButton.disabled = true;
      submitButton.textContent = "Sending…";
      if (status) status.textContent = "Sending your message…";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) throw new Error(result.error || "Your message could not be sent.");

        form.reset();
        if (status) status.textContent = "Thanks — your message was sent. Brandon will get back to you soon.";
      } catch (error) {
        const message = error instanceof Error ? error.message : "Your message could not be sent.";
        if (status) status.textContent = `${message} You can also email hello@brandonjohnson.dev.`;
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Send message";
      }
    });
  </script>
</BaseLayout>
